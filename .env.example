# Copy to .env for local development. Never commit real keys.

# Optional: enables the AI reader (Google Gemini). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# auto = use the AI reader when a key is present; off = rules + OCR only
AI_MODE=auto

# Demo pacing (ms per stage) so each stage is visible live. 0 = full speed.
STAGE_DELAY_MS=650

# Optional: require this token for "Reset demo data"
ADMIN_TOKEN=

# Where SQLite + uploaded PDFs are stored
# DATA_DIR=./data/runtime
